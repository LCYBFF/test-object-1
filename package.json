{
  "name": "resume-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "pnpm monorepo: Fastify API + Nuxt web + Drizzle/PostgreSQL 个人简历单页",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @resume/api dev",
    "dev:web": "pnpm --filter @resume/web dev",
    "build": "pnpm --filter @resume/web build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @resume/db generate",
    "db:migrate": "pnpm --filter @resume/db migrate",
    "db:seed": "pnpm --filter @resume/db seed",
    "db:studio": "pnpm --filter @resume/db studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}